{
  "manifest_version": 3,
  "name": "ThirdNote: Capture Everything. Remember Anything.",
  "short_name": "ThirdNote",
  "version": "1.0.1",
  "description": "Save highlights, screenshots and ideas from AI chats and any website. Organise them on a board and review as flashcards.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open ThirdNote",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_page": "options/options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Open ThirdNote"
    },
    "capture-area": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Capture an area of the page"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/shared.js",
        "lib/i18n.js",
        "lib/sanitize.js",
        "lib/anchor.js",
        "content/adapters.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
